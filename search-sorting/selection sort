#include<stdio.h>
int main()
{
    int arr[100],min,i,j, n,temp;

    printf("ENTER SIZE OF THE ARRAY: ");
    scanf("%d",&n);

    printf("ENTER THE ELEMENT IN THE ARRAY: \n");
    for(i=0; i<n; i++){
        scanf("%d",&arr[i]);
    }

    printf("SORTED ARRAY: \n");
    for(i=0; i<n-1; i++){
        min=i;
        for(j=i+1; j<n; j++){
            if(arr[min]>arr[j]){
                min=j;
            }
        }
        temp=arr[i];
        arr[i]= arr[min];
        arr[min]=temp;
    }
    for(i=0; i<n; i++){
        printf("%d ",arr[i]);
    }

    return 0;
}
