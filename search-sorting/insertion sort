#include<stdio.h>
int main()
{
    int j, n,temp, arr[100];

    printf("ENTER THE NO. OF ELEMENT IN THE ARRAY: "); 
    scanf("%d",&n);

    printf("ENTER THE ELEMENT: ");
    for(int i=0; i<n; i++){
        scanf("%d",&arr[i]);
    }

    for(int i=0; i<n; i++){
        temp= arr[i];
        j=i-1;
        while((j>=0) && temp < arr[j]){
            arr[j+1] = arr[j];
            j=j-1;
        }
        arr[j+1]=temp;
    }
    
    printf("THE SORTED ARRAY: \n");
    for(int i=0; i<n; i++){
        printf("%d ",arr[i]);
    }


    return 0;
}
