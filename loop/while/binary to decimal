#include<stdio.h>
#include<math.h>
int main()
{
    int binary, decimal=0, i=0, rem=0;
    
    printf("enter the binay number: ");
    scanf("%d",&binary);

    while(binary>0){
        rem=binary%10;
        binary= binary/10;
        decimal= decimal+ rem*pow(2,i);
        i++;
    }

    printf("\ndecimal form of binary number is %d", decimal);

    return 0;
}

//Binary to decimal conversion is done by multiplying each binary digit with its corresponding power of 2 and adding the results
