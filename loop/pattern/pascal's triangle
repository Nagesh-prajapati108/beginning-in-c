#include<stdio.h>
int factorial(int n){
    if(n==0)
    return 1;

    else 
    return n*factorial(n-1);
}

int ncr(int n, int r){
    int ncr=factorial(n)/(factorial(r)*factorial(n-r));

    return ncr;
}

int main()
{
    int rows,i,j,space;
    
    printf("enter the number of rows: ");
    scanf("%d",&rows);
    
    for(i=0; i<rows; i++){
        for(space=0; space<=rows-i-1; space++){
            printf(" ");
        }
        for(j=0; j<=i; j++){
            printf("%d ",ncr(i,j));
        }
        
        printf("\n");
    }

    return 0;
}
