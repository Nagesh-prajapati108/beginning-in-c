#include<stdio.h>
int main()
{
    int i=0,j;
    char s1[100],s2[200];

    printf("Enter the first string: ");
    fgets(s1, 100,  stdin);
    s1[strcspn(s1, "\n")]= '\0';

    printf("Enter the second string: ");
    fgets(s2, 100,  stdin);
    s2[strcspn(s2, "\n")]= '\0';

    while(s1[i]!='\0'){
        i++;
    }
    for(j=0; s2[j]!='\0'; j++){
        s1[i]=s2[j];
        i++;
    }
    s1[i]='\0';

    printf("concatinated string: %s", s1);

    return 0;
}
